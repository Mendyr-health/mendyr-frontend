// Mendyr — Home Healthcare Platform
// Prisma Schema — PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  NURSE
  PATIENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_APPROVAL
  PENDING_VERIFICATION
}

enum NurseVerificationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum PatientRegistrationStatus {
  PENDING_APPROVAL
  APPROVED
  WAITLISTED
}

enum DocumentType {
  AADHAAR
  CERTIFICATE
  PROFILE_PHOTO
  OTHER
}

enum ContactStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  APPROVE
  REJECT
  SUSPEND
  REACTIVATE
  PASSWORD_RESET
  ROLE_CHANGE
  PERMISSION_CHANGE
  SETTINGS_CHANGE
}

// ─────────────────────────────────────────────
// USER & AUTH
// ─────────────────────────────────────────────

model User {
  id             String     @id @default(uuid(7)) @db.Uuid
  publicId       String     @unique @default(uuid(7)) @db.Uuid
  email          String     @unique
  phone          String?
  passwordHash   String
  fullName       String
  role           UserRole   @default(PATIENT)
  status         UserStatus @default(PENDING_APPROVAL)
  emailVerified  Boolean    @default(false)
  avatarUrl      String?
  lastLoginAt    DateTime?
  loginAttempts  Int        @default(0)
  lockedUntil    DateTime?
  googleId       String?    @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  patientProfile PatientProfile?
  nurseProfile   NurseProfile?
  refreshTokens  RefreshToken[]
  notifications  Notification[]
  auditLogs      AuditLog[]     @relation("AuditUser")
  createdAudits  AuditLog[]     @relation("AuditActor")
  roleAssignment UserRoleAssignment[]

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([publicId])
  @@index([deletedAt])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid(7)) @db.Uuid
  token     String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────
// RBAC — Roles & Permissions
// ─────────────────────────────────────────────

model Role {
  id          String @id @default(uuid(7)) @db.Uuid
  publicId    String @unique @default(uuid(7)) @db.Uuid
  name        String @unique
  slug        String @unique
  description String?
  hierarchy   Int    @default(99) // Lower = higher authority (SUPER_ADMIN=0)
  isSystem    Boolean @default(false) // System roles can't be deleted

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions RolePermission[]
  userAssignments UserRoleAssignment[]

  @@index([slug])
  @@map("roles")
}

model Permission {
  id          String @id @default(uuid(7)) @db.Uuid
  publicId    String @unique @default(uuid(7)) @db.Uuid
  resource    String // e.g. "nurse", "patient", "service", "admin"
  action      String // e.g. "create", "read", "update", "delete", "approve"
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid(7)) @db.Uuid
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  createdAt DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @db.Uuid
  roleId String @db.Uuid

  assignedAt DateTime @default(now())
  assignedBy String?  @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_role_assignments")
}

// ─────────────────────────────────────────────
// PATIENT
// ─────────────────────────────────────────────

model PatientProfile {
  id                 String                    @id @default(uuid(7)) @db.Uuid
  publicId           String                    @unique @default(uuid(7)) @db.Uuid
  userId             String                    @unique @db.Uuid
  address            String?
  city               String?
  state              String?
  registrationStatus PatientRegistrationStatus @default(PENDING_APPROVAL)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([registrationStatus])
  @@index([city])
  @@map("patient_profiles")
}

// ─────────────────────────────────────────────
// NURSE
// ─────────────────────────────────────────────

model NurseProfile {
  id                 String                   @id @default(uuid(7)) @db.Uuid
  publicId           String                   @unique @default(uuid(7)) @db.Uuid
  userId             String                   @unique @db.Uuid
  gender             Gender?
  dateOfBirth        DateTime?
  address            String?
  city               String?
  state              String?
  experience         String?                  // Years + description
  qualifications     String?                  // JSON array of qualifications
  certifications     String?                  // JSON array of certifications
  verificationStatus NurseVerificationStatus  @default(PENDING)
  verifiedAt         DateTime?
  verifiedBy         String?                  @db.Uuid
  rejectionReason    String?
  preferredContact   String?                  // email, phone, whatsapp
  availabilityPrefs  String?                  // JSON weekly availability

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents NurseDocument[]

  @@index([verificationStatus])
  @@index([city])
  @@map("nurse_profiles")
}

model NurseDocument {
  id             String       @id @default(uuid(7)) @db.Uuid
  publicId       String       @unique @default(uuid(7)) @db.Uuid
  nurseProfileId String       @db.Uuid
  type           DocumentType
  fileName       String
  fileUrl        String
  fileSize       Int?
  mimeType       String?
  verified       Boolean      @default(false)
  verifiedAt     DateTime?
  verifiedBy     String?      @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nurseProfile NurseProfile @relation(fields: [nurseProfileId], references: [id], onDelete: Cascade)

  @@index([nurseProfileId])
  @@index([type])
  @@map("nurse_documents")
}

// ─────────────────────────────────────────────
// SERVICES
// ─────────────────────────────────────────────

model Service {
  id           String  @id @default(uuid(7)) @db.Uuid
  publicId     String  @unique @default(uuid(7)) @db.Uuid
  name         String  @unique
  slug         String  @unique
  description  String
  shortDesc    String?
  heroImage    String?
  icon         String? // Lucide icon name
  features     String? // JSON array
  pricingRange String? // e.g. "₹500 - ₹2000/day"
  isActive     Boolean @default(true)
  sortOrder    Int     @default(0)

  // SEO
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([slug])
  @@index([isActive])
  @@map("services")
}

// ─────────────────────────────────────────────
// CONTACT & WAITLIST
// ─────────────────────────────────────────────

model ContactInquiry {
  id       String        @id @default(uuid(7)) @db.Uuid
  publicId String        @unique @default(uuid(7)) @db.Uuid
  name     String
  email    String
  phone    String?
  subject  String
  message  String
  status   ContactStatus @default(NEW)
  notes    String?       // Admin internal notes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([email])
  @@map("contact_inquiries")
}

model Waitlist {
  id       String  @id @default(uuid(7)) @db.Uuid
  publicId String  @unique @default(uuid(7)) @db.Uuid
  email    String  @unique
  name     String?
  phone    String?
  source   String? // e.g. "landing", "registration", "nurse-signup"
  notified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([notified])
  @@map("waitlist")
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

model Notification {
  id       String  @id @default(uuid(7)) @db.Uuid
  publicId String  @unique @default(uuid(7)) @db.Uuid
  userId   String  @db.Uuid
  type     String  // e.g. "nurse_approved", "welcome", "status_change"
  title    String
  message  String
  read     Boolean @default(false)
  readAt   DateTime?
  metadata String? // JSON for extra data

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@map("notifications")
}

// ─────────────────────────────────────────────
// AUDIT LOGS
// ─────────────────────────────────────────────

model AuditLog {
  id         String      @id @default(uuid(7)) @db.Uuid
  userId     String?     @db.Uuid // The user being acted upon
  actorId    String?     @db.Uuid // The user performing the action
  action     AuditAction
  resource   String              // e.g. "user", "nurse", "service"
  resourceId String?     @db.Uuid
  oldValue   String?             // JSON snapshot of old state
  newValue   String?             // JSON snapshot of new state
  ipAddress  String?
  userAgent  String?
  metadata   String?             // Extra context JSON

  createdAt DateTime @default(now())

  user  User? @relation("AuditUser", fields: [userId], references: [id], onDelete: SetNull)
  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// SYSTEM SETTINGS
// ─────────────────────────────────────────────

model SystemSetting {
  id    String @id @default(uuid(7)) @db.Uuid
  key   String @unique
  value String
  type  String @default("string") // string, boolean, number, json
  group String @default("general") // general, auth, email, etc.
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([group])
  @@map("system_settings")
}
