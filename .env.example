# ──────────────── App ────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Mendyr

# ──────────────── Database ────────────────
DATABASE_URL=postgresql://mendyr:mendyr_secret@localhost:5432/mendyr_db

# ──────────────── JWT Auth ────────────────
JWT_SECRET=change-this-to-a-64-char-random-hex-string-in-production-please
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ──────────────── Google OAuth ────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ──────────────── Google Analytics ────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ──────────────── Redis ────────────────
REDIS_URL=redis://localhost:6379

# ──────────────── OpenSearch ────────────────
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin

# ──────────────── S3 / MinIO ────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=mendyr-uploads
S3_REGION=us-east-1

# ──────────────── Email (Resend) ────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=noreply@mendyr.com

# ──────────────── Super Admin Seed ────────────────
SUPER_ADMIN_EMAIL=admin@mendyr.com
SUPER_ADMIN_PASSWORD=SuperAdmin@123!

# ──────────────── Rate Limiting ────────────────
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REGISTER=3
RATE_LIMIT_API=100
